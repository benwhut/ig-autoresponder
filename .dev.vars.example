# Copy to .dev.vars for local development (never commit .dev.vars).
# For production set each of these with `wrangler secret put <NAME>`.

# Meta App Dashboard -> Instagram -> API setup with Instagram business login -> App secret.
# Use the Instagram App Secret (not the Facebook App Secret), or webhook signatures fail.
IG_APP_SECRET="replace-me"

# Any random string. Must match the "Verify token" you enter in the Meta webhook config.
WEBHOOK_VERIFY_TOKEN="replace-with-a-random-string"

# Password for /admin
ADMIN_PASSWORD="replace-with-a-strong-password"

# Random string used to sign the admin session cookie.
SESSION_SECRET="replace-with-a-long-random-string"

# 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-base64-32-bytes"

# Optional, defaults to v25.0
GRAPH_API_VERSION="v25.0"
