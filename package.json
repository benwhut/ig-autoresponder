{
  "name": "ig-comment-autoresponder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-cost Instagram comment-to-DM autoresponder on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute DB --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.0.0"
  }
}
